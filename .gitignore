# ==================== Python 项目 .gitignore ====================
# 2025大创 - 农村女性就业市场动态演化机制研究项目
# 忽略虚拟环境、缓存文件、临时文件等不需要版本控制的文件

# ===== 虚拟环境 =====
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ===== Python 缓存和编译文件 =====
__pycache__/
*.py[cod]
*$py.class
*.so
*.dll
*.pyd

# ===== 分发和打包 =====
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ===== 测试和覆盖率 =====
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ===== Jupyter Notebook 检查点 =====
.ipynb_checkpoints

# ===== IPython =====
profile_default/
ipython_config.py

# ===== 环境配置文件 =====
.env
.venv
.ENV
.env.local
.env.*.local

# ===== IDE 和编辑器文件 =====
.vscode/
.idea/
*.swp
*.swo
*~

# ===== 系统文件 =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===== 日志和临时文件 =====
*.log
*.tmp
*.temp
*.bak
*.backup

# ===== 数据文件（大文件）=====
# 注意：根据需要调整，有些数据文件可能需要版本控制
*.csv.bak
*.xlsx.bak
*.pickle
*.pkl
*.h5
*.hdf5

# ===== 模型和结果文件 =====
# 注意：根据研究需要，某些结果文件可能需要保留
models/checkpoints/
results/temp/
output/temp/

# ===== 文档生成 =====
docs/_build/
.readthedocs.yml
site/

# ===== 其他 =====
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# ===== 项目特定 =====
# 如果有特定的临时文件或测试输出，可以在这里添加
*_test.py.backup
*_old.py
experimental/
deprecated/
.augment/rules/imported/rules/rule.md

# ==============================================================================
# 项目特定补充 (科研、AI工具、跨平台)
# ==============================================================================

# ===== Stata 相关 (科研项目常用) =====
*.dta
*.gph
*.smcl
*.stpr
*.sthlp
*.stsem

# ===== AI 辅助工具配置 =====
.cursor/
.augment/
.windsurfrules
.windsurf/

# ===== 数据与结果目录的强化忽略 (适配大小写和多级子目录) =====
# 1. 忽略所有层级的 DATA 和 OUTPUT 目录下的生成产物
**/DATA/raw/*
**/DATA/processed/*
!**/DATA/raw/.gitkeep
!**/DATA/processed/.gitkeep

**/OUTPUT/**/*
**/output/**/*
!**/OUTPUT/.gitkeep
!**/output/.gitkeep

# 2. 全局忽略常见的图像/图表产物 (如论文插图中间过程、调试图等)
*.png
*.jpg
*.jpeg
*.svg
*.pdf
# 若需要将某个临时 PDF 标记为版本控制，可通过 git add -f 强制添加

# 3. 白名单：保留正式的文档、报告 (不包含图片类)
!/docs/**/*
!/Docs/**/*
!/终期结项/**/*
!/立项书与中期报告书/**/*

# 额外保护：大容量数据格式 (常用于模拟)
*.parquet
*.feather
*.json.gz
*.pt
*.pth
*.onnx

# ===== 打包与分发补充 =====
*.spec
activate_env.bat
run_gui.bat
run_gui_fixed.bat

# ===== 系统与冗余 =====
Thumbs.db
desktop.ini
.DS_Store

# ==============================================================================
# 最终覆盖规则 (强制忽略)
# ==============================================================================
*.png
*.jpg
*.jpeg
*.dta
*.sav
*.dta.t
*.pdf
*.doc
*.docx
*.docm
# 以上规则强制忽略了全项目范围内的模拟结果、大型数据以及 Word 报告原稿。
